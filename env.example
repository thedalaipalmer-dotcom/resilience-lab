import React, { useState } from 'react';
import { motion } from 'motion/react';
import { useApp } from '../context/AppContext';
import { ShieldCheck, Zap, ArrowRight, Github } from 'lucide-react';

export const Auth: React.FC = () => {
  const { signIn, loading } = useApp();

  return (
    <div className="min-h-[80vh] flex flex-col items-center justify-center text-center px-6">
      <motion.div
        initial={{ opacity: 0, scale: 0.8 }}
        animate={{ opacity: 1, scale: 1 }}
        className="mb-12"
      >
        <div className="w-24 h-24 bg-gradient-to-br from-indigo-500 via-teal-400 to-indigo-600 rounded-3xl flex items-center justify-center shadow-2xl shadow-indigo-500/40 mb-8 mx-auto">
          <ShieldCheck className="text-white w-12 h-12" />
        </div>
        <h1 className="text-6xl md:text-8xl font-black text-white tracking-tighter uppercase leading-[0.8] mb-6">
          The <br /><span className="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-teal-400">Resilience</span> <br />Lab
        </h1>
        <p className="text-xl md:text-2xl text-slate-400 max-w-xl mx-auto leading-relaxed font-light">
          Your premium digital well-being coach. Proven techniques, Zero textbook vibes.
        </p>
      </motion.div>

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.3 }}
        className="space-y-6 w-full max-w-sm"
      >
        <button
          onClick={signIn}
          disabled={loading}
          className="group relative w-full bg-white text-black font-black uppercase tracking-tighter px-8 py-5 rounded-2xl hover:bg-teal-400 transition-all flex items-center justify-center gap-4 text-xl shadow-xl hover:shadow-teal-400/20"
        >
          <span>Begin Journey</span>
          <ArrowRight className="w-6 h-6 group-hover:translate-x-1 transition-transform" />
        </button>

        <p className="text-slate-500 text-xs uppercase tracking-widest font-bold">
          Secure Google Authentication Required
        </p>

        <div className="pt-12 grid grid-cols-2 gap-4">
          <div className="p-6 rounded-2xl bg-white/5 border border-white/5 text-left">
            <Zap className="w-6 h-6 text-yellow-400 mb-3" />
            <h4 className="text-white font-bold uppercase text-xs tracking-widest mb-1">Micro-Wins</h4>
            <p className="text-[10px] text-slate-500 leading-normal">Bite-sized real world actions that build resilience.</p>
          </div>
          <div className="p-6 rounded-2xl bg-white/5 border border-white/5 text-left">
            <ShieldCheck className="w-6 h-6 text-indigo-400 mb-3" />
            <h4 className="text-white font-bold uppercase text-xs tracking-widest mb-1">Science-Based</h4>
