};

export const Setup: React.FC = () => {
  const { updateAgeGroup } = useApp();

  const options = [
    { 
      id: 'tweens', 
      label: 'Tweens', 
      range: '10-14', 
      color: 'from-emerald-300 via-pink-300 to-yellow-200',
      desc: 'Master the basics: Group chats, gaming logic, and school vibes.'
    },
    { 
      id: 'gen-z', 
      label: 'Teens', 
      range: '14-16', 
      color: 'from-teal-400 via-cyan-500 to-indigo-500',
      desc: 'Level up: Handling ghosting, burnout, and digital noise.'
    },
    { 
      id: 'young-adults', 
      label: 'Adulting', 
      range: '16-20', 
      color: 'from-indigo-600 via-slate-800 to-slate-900',
      desc: 'Real world ready: Career pressure, finances, and deep focus.'
    },
  ];

  return (
    <div className="max-w-6xl mx-auto py-8 md:py-12 px-6 text-center">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="space-y-4 mb-12 md:mb-16"
      >
        <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-black uppercase tracking-widest mb-4">
          Personalization Required
        </div>
        <h2 className="text-4xl md:text-6xl font-black text-white tracking-tight uppercase leading-none">Identify Your Era</h2>
        <p className="text-slate-400 text-base md:text-lg max-w-2xl mx-auto">
          We curate your resilience modules based on your current path. Choose where you are today.
        </p>
      </motion.div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8 max-w-5xl mx-auto">
        {options.map((opt, idx) => (
          <motion.div
            key={opt.id}
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: idx * 0.1 }}
            whileHover={{ scale: 1.02 }}
            whileTap={{ scale: 0.98 }}
            onClick={() => updateAgeGroup(opt.id as any)}
            className="cursor-pointer group flex h-full"
          >
            <div className={`relative w-full flex flex-col items-center bg-white/5 border border-white/10 p-8 md:p-10 rounded-[40px] group-hover:border-white/30 transition-all overflow-hidden`}>
              {/* Background Glow */}
              <div className={`absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br ${opt.color} opacity-0 group-hover:opacity-10 transition-opacity blur-[100px]`} />
              
              <div className={`w-20 h-20 md:w-24 md:h-24 rounded-3xl bg-gradient-to-br ${opt.color} mb-8 shadow-2xl flex items-center justify-center`}>
                <Zap className="text-white w-10 h-10 md:w-12 md:h-12" />
              </div>
              
              <div className="space-y-4 flex-grow">
                <h3 className="text-2xl md:text-3xl font-black text-white uppercase tracking-tight">{opt.label}</h3>
                <div className="inline-block px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-500 font-bold uppercase tracking-widest text-[10px]">
                  Ages {opt.range}
                </div>
                <p className="text-slate-400 text-sm leading-relaxed max-w-[200px] mx-auto">
                  {opt.desc}
                </p>
              </div>
              
              <div className="mt-10">
                <div className="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-black transition-all">
                  <ArrowRight className="w-6 h-6" />
                </div>
              </div>
            </div>
          </motion.div>
        ))}
      </div>
      
      <p className="mt-12 text-slate-600 text-[10px] uppercase font-bold tracking-[0.2em]">
        You can reset your era at any time in the header
      </p>
    </div>
  );
};
